  var user = null;
  for (var i = 0; i < users.length; i++) {
    if (users[i].cnic === id && users[i].pass === pass) { user = users[i]; break; }
  }
  if (user) {
    currentUser = user; currentRole = user.role;
    localStorage.setItem('apms_logged', 'yes');
    localStorage.setItem('apms_current_cnic', user.cnic);
