// ===== FIRESTORE HELPERS =====
async function fbLoad(collectionName) {
  if (!window.firebaseReady) return [];
  try {
    const q = window.fbFunctions.query(window.fbFunctions.collection(window.db, collectionName));
    const snapshot = await window.fbFunctions.getDocs(q);
    var arr = [];
    snapshot.forEach(function(d) { arr.push(Object.assign({}, d.data(), { _id: d.id })); });
    return arr;
  } catch (e) { console.log('Load error', collectionName, e); return []; }
}

async function fbAdd(collectionName, data) {
  if (!window.firebaseReady) return null;
  try {
    const ref = await window.fbFunctions.addDoc(window.fbFunctions.collection(window.db, collectionName), data);
    return ref.id;
  } catch (e) { console.log('Add error', e); return null; }
}

async function fbDelete(collectionName, data) {
  if (!window.firebaseReady) return;
  try {
    // Find by id field
    const q = window.fbFunctions.query(window.fbFunctions.collection(window.db, collectionName));
    const snapshot = await window.fbFunctions.getDocs(q);
    snapshot.forEach(async function(d) {
      if (d.data().id === data.id) {
        await window.fbFunctions.deleteDoc(window.fbFunctions.doc(window.db, collectionName, d.id));
      }
    });
  } catch (e) { console.log('Delete error', e); }
}

async function loadAllFromFirebase() {
  students = await fbLoad('students');
  teachers = await fbLoad('teachers');
  classes = await fbLoad('classes');
  timetable = await fbLoad('timetable');
  staff = await fbLoad('staff');
  admissions = await fbLoad('admissions');
  results = await fbLoad('results');
  users = await fbLoad('users');
  
  // Seed default users if empty
  if (users.length === 0) {
    for (var i = 0; i < DEFAULT_USERS.length; i++) {
      await fbAdd('users', DEFAULT_USERS[i]);
    }
    users = DEFAULT_USERS.slice();
  }
}

// ===== INIT =====
async function initApp() {
  // Wait for Firebase to be ready
  var attempts = 0;
  while (!window.firebaseReady && attempts < 50) {
    await new Promise(function(r) { setTimeout(r, 100); });
    attempts++;
  }
  
  if (window.firebaseReady) {
    window.updateSyncStatus('on');
    await loadAllFromFirebase();
  } else {
    window.updateSyncStatus('off');
    // Load from localStorage as fallback
    students = JSON.parse(localStorage.getItem('apms_students') || '[]');
    teachers = JSON.parse(localStorage.getItem('apms_teachers') || '[]');
    classes = JSON.parse(localStorage.getItem('apms_classes') || '[]');
    timetable = JSON.parse(localStorage.getItem('apms_tt') || '[]');
    staff = JSON.parse(localStorage.getItem('apms_staff') || '[]');
    admissions = JSON.parse(localStorage.getItem('apms_admissions') || '[]');
    results = JSON.parse(localStorage.getItem('apms_results') || '[]');
    users = JSON.parse(localStorage.getItem('apms_users') || JSON.stringify(DEFAULT_USERS));
  }
  
  // Check auto login
  if (localStorage.getItem('apms_logged') === 'yes') {
    var cnic = localStorage.getItem('apms_current_cnic');
    var u = users.find(function(x) { return x.cnic === cnic; });
    if (u) { currentUser = u; currentRole = u.role; startApp(); }
  }
}

