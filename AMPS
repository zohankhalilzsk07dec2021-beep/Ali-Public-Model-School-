<!DOCTYPE html>
<html lang="ur" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#1e3c72">
<title>ALI PUBLIC MODEL SCHOOL</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Nastaliq+Urdu:wght@400;700&display=swap" rel="stylesheet">
<style>
* { margin:0; padding:0; box-sizing:border-box; font-family:'Noto Nastaliq Urdu', serif; -webkit-tap-highlight-color:transparent; }
body { background: linear-gradient(135deg,#1e3c72,#2a5298); min-height:100vh; color:#333; }

.login-screen { position:fixed; top:0; left:0; right:0; bottom:0; background:linear-gradient(135deg,#0f2027,#203a43,#2c5364); z-index:9999; display:flex; align-items:center; justify-content:center; padding:20px; overflow-y:auto; }
.login-screen.hidden { display:none !important; }
.login-box { background:#fff; border-radius:20px; padding:30px 25px; max-width:400px; width:100%; text-align:center; box-shadow:0 20px 60px rgba(0,0,0,0.5); border-top:6px solid #ffd700; }
.login-box .logo-circle { width:85px; height:85px; border-radius:50%; background:linear-gradient(135deg,#1e3c72,#2a5298); display:flex; align-items:center; justify-content:center; font-size:42px; margin:0 auto 15px; border:4px solid #ffd700; }
.login-box h2 { color:#1e3c72; font-size:20px; margin-bottom:5px; }
.login-box p { color:#666; font-size:13px; margin-bottom:20px; }
.role-tabs { display:flex; gap:6px; margin:10px 0; }
.role-tab { flex:1; padding:10px 5px; background:#f0f4ff; border-radius:10px; cursor:pointer; font-size:11px; font-weight:bold; color:#1e3c72; border:2px solid transparent; text-align:center; }
.role-tab.active { background:linear-gradient(135deg,#1e3c72,#2a5298); color:#fff; border-color:#ffd700; }
.role-tab .rt-icon { font-size:18px; display:block; margin-bottom:3px; }
.login-box input { width:100%; padding:14px; margin:8px 0; border:2px solid #ddd; border-radius:12px; font-size:14px; background:#f9f9f9; text-align:center; font-family:'Noto Nastaliq Urdu',serif; }
.login-box input:focus { outline:none; border-color:#2a5298; background:#fff; }
.login-btn { width:100%; background:linear-gradient(135deg,#1e3c72,#2a5298); color:#fff; border:none; padding:15px; border-radius:12px; cursor:pointer; font-size:16px; font-weight:bold; margin-top:10px; font-family:'Noto Nastaliq Urdu',serif; }
.login-hint { font-size:11px; color:#999; margin-top:15px; background:#f0f4ff; padding:10px; border-radius:8px; line-height:1.8; }
.login-copyright { margin-top:18px; padding-top:12px; border-top:1px dashed #ccc; font-size:11px; color:#666; }
.login-copyright b { color:#1e3c72; font-size:13px; }
.sync-status { font-size:11px; padding:6px 12px; border-radius:20px; display:inline-block; margin-top:8px; }
.sync-on { background:#d4edda; color:#155724; }
.sync-off { background:#f8d7da; color:#721c24; }
.sync-loading { background:#fff3cd; color:#856404; }

.header { background: linear-gradient(135deg,#0f2027,#203a43,#2c5364); color:#fff; padding:12px 15px; text-align:center; box-shadow:0 4px 20px rgba(0,0,0,0.4); border-bottom:4px solid #ffd700; position:sticky; top:0; z-index:200; }
.header h1 { font-size:18px; color:#ffd700; text-shadow:2px 2px 4px #000; }
.header p { font-size:11px; color:#e0e0e0; margin-top:3px; }
.header-top { display:flex; justify-content:space-between; align-items:center; margin-bottom:6px; flex-wrap:wrap; gap:6px; }
.header-top .date-badge { background:#ffd700; color:#000; padding:4px 10px; border-radius:20px; font-size:10px; font-weight:bold; }
.header-top .role-badge { background:#27ae60; color:#fff; padding:4px 10px; border-radius:20px; font-size:10px; font-weight:bold; }
.logout-btn { background:#e74c3c; color:#fff; border:none; padding:5px 10px; border-radius:20px; cursor:pointer; font-weight:bold; font-size:10px; }

.home-screen { max-width:1200px; margin:auto; padding:15px; padding-bottom:130px; }
.welcome-banner { background: linear-gradient(135deg,#ffd700,#ffb700); border-radius:18px; padding:18px; margin-bottom:15px; box-shadow:0 8px 25px rgba(255,215,0,0.4); display:flex; align-items:center; gap:12px; }
.welcome-banner .logo { width:60px; height:60px; border-radius:50%; background:#0f2027; display:flex; align-items:center; justify-content:center; font-size:32px; flex-shrink:0; border:3px solid #fff; }
.welcome-banner .txt h2 { color:#0f2027; font-size:18px; margin-bottom:3px; }
.welcome-banner .txt p { color:#333; font-size:12px; font-weight:bold; }
.welcome-banner .txt small { color:#555; font-size:10px; display:block; margin-top:3px; }

.stats-row { display:grid; grid-template-columns:repeat(2,1fr); gap:10px; margin-bottom:15px; }
.stat-box { background:#fff; border-radius:15px; padding:12px; text-align:center; box-shadow:0 5px 20px rgba(0,0,0,0.15); border-top:5px solid #2a5298; cursor:pointer; }
.stat-box .num { font-size:24px; font-weight:bold; color:#1e3c72; }
.stat-box .lbl { font-size:11px; color:#666; margin-top:3px; }
.stat-box.gold { border-top-color:#ffd700; }
.stat-box.green { border-top-color:#27ae60; }
.stat-box.red { border-top-color:#e74c3c; }
.stat-box.purple { border-top-color:#9b59b6; }

.sec-title { color:#fff; font-size:15px; margin:15px 0 10px; padding-right:12px; border-right:5px solid #ffd700; text-shadow:1px 1px 3px #000; }
.menu-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; }
.menu-item { background:#fff; border-radius:15px; padding:15px 8px; text-align:center; cursor:pointer; box-shadow:0 5px 15px rgba(0,0,0,0.2); border-bottom:4px solid transparent; }
.menu-item .mi-icon { font-size:28px; margin-bottom:6px; }
.menu-item .mi-lbl { font-size:11px; color:#1e3c72; font-weight:bold; }
.menu-item.admission { background:linear-gradient(135deg,#27ae60,#2ecc71); }
.menu-item.admission .mi-lbl { color:#fff; }
.menu-item.result { background:linear-gradient(135deg,#8e44ad,#9b59b6); }
.menu-item.result .mi-lbl { color:#fff; }

.section { display:none; background:#fff; margin:15px; padding:18px; border-radius:15px; box-shadow:0 10px 40px rgba(0,0,0,0.3); margin-bottom:130px; }
.section.active { display:block; }
.section h2 { color:#1e3c72; border-bottom:3px solid #ffd700; padding-bottom:10px; margin-bottom:15px; font-size:18px; }

input,select,textarea { width:100%; padding:12px; margin:7px 0; border:2px solid #ddd; border-radius:10px; font-family:'Noto Nastaliq Urdu',serif; font-size:13px; background:#f9f9f9; }
input:focus,select:focus { outline:none; border-color:#2a5298; background:#fff; }

.btn { background:linear-gradient(135deg,#1e3c72,#2a5298); color:#fff; border:none; padding:12px 20px; border-radius:10px; cursor:pointer; font-size:14px; margin:4px; font-family:'Noto Nastaliq Urdu',serif; }
.btn-danger { background:linear-gradient(135deg,#c0392b,#e74c3c); }
.btn-success { background:linear-gradient(135deg,#27ae60,#2ecc71); }
.btn-gold { background:linear-gradient(135deg,#d4af37,#ffd700); color:#000; }
.btn-purple { background:linear-gradient(135deg,#8e44ad,#9b59b6); }

table { width:100%; border-collapse:collapse; margin-top:12px; background:#fff; font-size:12px; }
th { background:linear-gradient(135deg,#1e3c72,#2a5298); color:#fff; padding:8px 5px; font-size:11px; }
td { padding:8px 5px; border-bottom:1px solid #eee; text-align:center; font-size:11px; }

.class-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(100px,1fr)); gap:10px; margin:15px 0; }
.class-card { background:linear-gradient(135deg,#e3f2fd,#bbdefb); border-radius:12px; padding:12px; text-align:center; cursor:pointer; border-left:5px solid #2a5298; }
.class-card .cls-num { font-size:20px; font-weight:bold; color:#1e3c72; }
.class-card .cls-info { font-size:10px; margin-top:5px; }

.student-card { background:linear-gradient(135deg,#fff,#f0f4ff); border:4px double #1e3c72; border-radius:15px; padding:20px; margin:15px auto; max-width:450px; box-shadow:0 10px 30px rgba(0,0,0,0.3); position:relative; overflow:hidden; }
.student-card::before { content:''; position:absolute; top:0; left:0; right:0; height:60px; background:linear-gradient(135deg,#1e3c72,#2a5298); }
.student-card .card-header { position:relative; color:#ffd700; text-align:center; font-size:17px; font-weight:bold; margin-bottom:50px; }
.student-card .photo { width:100px; height:100px; border-radius:50%; border:4px solid #ffd700; margin:-70px auto 10px; display:block; object-fit:cover; background:#fff; }
.student-card .info { text-align:right; padding:10px; }
.student-card .info p { margin:6px 0; font-size:12px; border-bottom:1px dashed #ccc; padding-bottom:4px; }
.student-card .info b { color:#1e3c72; }
.student-card .card-footer { text-align:center; font-size:10px; color:#888; margin-top:10px; padding-top:8px; border-top:1px dashed #ccc; }

.result-print-card { background:#fff; border:4px double #1e3c72; border-radius:12px; padding:20px; margin:15px auto; max-width:700px; box-shadow:0 10px 30px rgba(0,0,0,0.2); }
.result-print-card .rp-header { text-align:center; border-bottom:3px solid #1e3c72; padding-bottom:12px; margin-bottom:15px; }
.result-print-card .rp-header h2 { color:#1e3c72; font-size:22px; margin-bottom:5px; }
.result-print-card .rp-header p { font-size:12px; color:#666; }
.result-print-card .rp-exam { text-align:center; background:#8e44ad; color:#fff; padding:8px; border-radius:8px; margin:12px 0; font-weight:bold; font-size:14px; }
.result-print-card .rp-info { display:grid; grid-template-columns:1fr 1fr; gap:8px; background:#f0f4ff; padding:12px; border-radius:8px; margin-bottom:12px; }
.result-print-card .rp-info div { font-size:13px; }
.result-print-card .rp-info b { color:#1e3c72; }
.result-print-card .rp-subjects { width:100%; border-collapse:collapse; margin-top:10px; }
.result-print-card .rp-subjects th { background:#1e3c72; color:#fff; padding:8px; font-size:12px; border:1px solid #1e3c72; }
.result-print-card .rp-subjects td { padding:6px; border:1px solid #ddd; text-align:center; font-size:12px; }
.result-print-card .rp-summary { display:grid; grid-template-columns:repeat(4,1fr); gap:8px; margin-top:15px; background:#f0f4ff; padding:12px; border-radius:8px; }
.result-print-card .rp-summary div { text-align:center; }
.result-print-card .rp-summary .lbl { font-size:10px; color:#666; }
.result-print-card .rp-summary .val { font-size:16px; font-weight:bold; color:#1e3c72; }
.result-print-card .rp-footer { margin-top:15px; display:flex; justify-content:space-between; font-size:11px; padding-top:10px; border-top:1px dashed #ccc; }

.subject-row { display:grid; grid-template-columns:2fr 1fr 1fr 1fr; gap:5px; margin:5px 0; align-items:center; }
.subject-row input { margin:0; padding:8px; font-size:12px; }
.result-summary { background:linear-gradient(135deg,#f0f4ff,#e3f2fd); border:2px solid #2a5298; border-radius:12px; padding:12px; margin:12px 0; display:grid; grid-template-columns:repeat(2,1fr); gap:8px; }
.result-summary .item { text-align:center; padding:8px; background:#fff; border-radius:8px; }
.result-summary .item .lbl { font-size:10px; color:#666; }
.result-summary .item .val { font-size:16px; font-weight:bold; color:#1e3c72; }

.grade-badge { display:inline-block; padding:4px 12px; border-radius:20px; font-weight:bold; font-size:14px; color:#fff; }
.grade-Ap { background:linear-gradient(135deg,#27ae60,#2ecc71); }
.grade-A { background:linear-gradient(135deg,#16a085,#1abc9c); }
.grade-B { background:linear-gradient(135deg,#3498db,#5dade2); }
.grade-C { background:linear-gradient(135deg,#f39c12,#f1c40f); }
.grade-D { background:linear-gradient(135deg,#e67e22,#f39c12); }
.grade-F { background:linear-gradient(135deg,#c0392b,#e74c3c); }

.staff-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(140px,1fr)); gap:12px; margin-top:12px; }
.staff-card { background:linear-gradient(135deg,#fff,#fff8e1); border:3px solid #ffd700; border-radius:12px; padding:12px; text-align:center; }
.staff-card .s-photo { width:60px; height:60px; border-radius:50%; border:3px solid #2a5298; object-fit:cover; margin:0 auto 8px; display:block; background:#eef; }
.staff-card h4 { color:#1e3c72; font-size:13px; }
.staff-card p { font-size:11px; color:#666; margin:3px 0; }

.teacher-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(160px,1fr)); gap:12px; margin-top:12px; }
.teacher-card { background:linear-gradient(135deg,#fff,#e3f2fd); border:3px solid #2a5298; border-radius:12px; padding:12px; text-align:center; }
.teacher-card .t-photo { width:70px; height:70px; border-radius:50%; border:3px solid #ffd700; object-fit:cover; margin:0 auto 8px; display:block; background:#eef; }
.teacher-card h4 { color:#1e3c72; font-size:14px; }
.teacher-card p { font-size:11px; color:#666; margin:3px 0; }

.bottom-nav { position:fixed; bottom:0; left:0; right:0; background:#0f2027; display:flex; justify-content:space-around; padding:8px 0 6px; box-shadow:0 -4px 20px rgba(0,0,0,0.4); border-top:3px solid #ffd700; z-index:100; }
.bottom-nav button { background:none; border:none; color:#fff; cursor:pointer; font-size:9px; display:flex; flex-direction:column; align-items:center; padding:4px; font-family:'Noto Nastaliq Urdu',serif; flex:1; }
.bottom-nav button.active { color:#ffd700; }
.bottom-nav .nav-icon { font-size:20px; }

.copyright-footer { position:fixed; bottom:57px; left:0; right:0; background:rgba(15,32,39,0.96); color:#ffd700; text-align:center; padding:5px; font-size:10px; border-top:2px solid #ffd700; z-index:99; }
.copyright-footer .sk-logo { display:inline-block; background:linear-gradient(135deg,#ffd700,#ffb700); color:#0f2027; padding:2px 8px; border-radius:10px; font-weight:bold; margin:0 3px; font-size:10px; }

.file-label { display:inline-block; background:#2a5298; color:#fff; padding:10px 18px; border-radius:10px; cursor:pointer; margin:5px; font-size:13px; }
input[type="file"] { display:none; }

.filter-bar { display:flex; gap:8px; align-items:center; background:#f0f4ff; padding:10px; border-radius:10px; margin:10px 0; flex-wrap:wrap; }
.filter-bar input, .filter-bar select { margin:0; flex:1; min-width:120px; font-size:12px; }

.badge { display:inline-block; background:#ffd700; color:#000; padding:2px 8px; border-radius:20px; font-size:10px; font-weight:bold; }

.year-box { background:linear-gradient(135deg,#e8f5e9,#c8e6c9); border-left:5px solid #27ae60; padding:10px; border-radius:10px; margin:10px 0; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; }
.year-box b { color:#1b5e20; font-size:12px; }
.year-box select { margin:0; max-width:160px; font-size:12px; }

.date-badge-home { background:#fff; color:#1e3c72; padding:10px 12px; border-radius:12px; margin-bottom:15px; box-shadow:0 4px 15px rgba(0,0,0,0.15); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; border-left:5px solid #ffd700; }
.date-badge-home .dt { font-size:12px; font-weight:bold; color:#1e3c72; }
.date-badge-home .dy { font-size:10px; color:#666; }

.copyright-box { background:linear-gradient(135deg,#1e3c72,#2a5298); color:#fff; padding:20px; border-radius:15px; text-align:center; margin-top:20px; border:2px solid #ffd700; }
.copyright-box h3 { color:#ffd700; margin-bottom:10px; font-size:16px; }
.copyright-box .sk-badge { display:inline-block; background:linear-gradient(135deg,#ffd700,#ffb700); color:#0f2027; padding:8px 20px; border-radius:25px; font-weight:bold; font-size:15px; margin:10px 0; }
.copyright-box p { font-size:11px; color:#e0e0e0; margin:5px 0; }

.address-box { background:#f0f4ff; padding:12px; border-radius:10px; margin:8px 0; border-right:4px solid #2a5298; }
.address-box label { font-size:12px; color:#1e3c72; font-weight:bold; display:block; margin-bottom:5px; }

.admission-card { background:linear-gradient(135deg,#fff,#e8f5e9); border:3px solid #27ae60; border-radius:12px; padding:12px; margin:10px 0; }
.admission-card .adm-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; padding-bottom:8px; border-bottom:1px dashed #27ae60; flex-wrap:wrap; gap:5px; }
.admission-card .adm-no { background:linear-gradient(135deg,#27ae60,#2ecc71); color:#fff; padding:4px 12px; border-radius:20px; font-size:11px; font-weight:bold; }
.admission-card .adm-date { background:#ffd700; color:#000; padding:4px 10px; border-radius:20px; font-size:10px; font-weight:bold; }
.admission-card .adm-body { font-size:12px; line-height:1.8; }
.admission-card .adm-body b { color:#1e3c72; }

.tt-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(130px,1fr)); gap:10px; }
.tt-cell { background:linear-gradient(135deg,#e3f2fd,#bbdefb); padding:10px; border-radius:10px; text-align:center; border-left:4px solid #2a5298; font-size:12px; }
.tt-cell b { display:block; color:#1e3c72; margin-bottom:5px; }

.user-card { background:linear-gradient(135deg,#fff,#f0f4ff); border:3px solid #2a5298; border-radius:12px; padding:12px; margin:10px 0; display:flex; justify-content:space-between; align-items:center; gap:10px; flex-wrap:wrap; }
.user-card .uc-info { flex:1; }
.user-card h4 { color:#1e3c72; font-size:14px; margin-bottom:3px; }
.user-card p { font-size:11px; color:#666; }
.user-card .uc-actions { display:flex; gap:5px; }
.role-badge-user { display:inline-block; padding:2px 10px; border-radius:20px; font-size:10px; font-weight:bold; color:#fff; }
.role-admin { background:linear-gradient(135deg,#e74c3c,#c0392b); }
.role-teacher { background:linear-gradient(135deg,#3498db,#2980b9); }
.role-parent { background:linear-gradient(135deg,#27ae60,#229954); }
.role-staff { background:linear-gradient(135deg,#9b59b6,#8e44ad); }

@media(max-width:400px){ .menu-grid { grid-template-columns:repeat(2,1fr); } }

@media print {
  body * { visibility: hidden; }
  #printArea, #printArea * { visibility: visible; }
  #printArea { position: absolute; left: 0; top: 0; width: 100%; }
  .bottom-nav, .copyright-footer, .header { display: none !important; }
}
</style>
</head>
<body>

<!-- LOGIN -->
<div class="login-screen" id="loginScreen">
  <div class="login-box">
    <div class="logo-circle">🏫</div>
    <h2>علی پبلک ماڈل سکول</h2>
    <p>بستی نہووالہ، نوں</p>
    
    <div class="role-tabs">
      <div class="role-tab active" data-role="admin" onclick="selectRole('admin', this)"><span class="rt-icon">👑</span>ایڈمن</div>
      <div class="role-tab" data-role="teacher" onclick="selectRole('teacher', this)"><span class="rt-icon">👨‍🏫</span>ٹیچر</div>
      <div class="role-tab" data-role="parent" onclick="selectRole('parent', this)"><span class="rt-icon">👨‍👩‍👧</span>والدین</div>
    </div>
    
    <input type="text" id="loginId" placeholder="🆔 CNIC نمبر" maxlength="15">
    <input type="password" id="loginPass" placeholder="🔒 پاس ورڈ">
    <button class="login-btn" onclick="doLogin()">🔓 لاگ ان</button>
    
    <div id="syncStatus" class="sync-status sync-loading">⏳ Firebase connect ho raha hai...</div>
    
    <div class="login-hint">
      <b>ڈیمو CNIC:</b><br>
      👑 Admin: 35202-1234567-1<br>
      👨‍🏫 Teacher: 35202-7654321-1<br>
      👨‍👩‍👧 Parent: 35202-1111111-1<br>
      <b>پاس ورڈ:</b> admin123
    </div>
    
    <div class="login-copyright">
      <b>💻 KHALIL Developer</b><br>© 2025 All Rights Reserved
    </div>
  </div>
</div>

<!-- HEADER -->
<div class="header" id="mainHeader" style="display:none;">
  <div class="header-top">
    <span class="date-badge" id="headerDate">--</span>
    <span class="role-badge" id="roleBadge">👑 Admin</span>
    <button class="logout-btn" onclick="doLogout()">🚪 لاگ آؤٹ</button>
  </div>
  <h1 id="schoolName">علی پبلک ماڈل سکول</h1>
  <p id="schoolAddr">بستی نہووالہ، نوں</p>
</div>

<div id="mainContainer" style="display:none;">

<!-- HOME -->
<div class="home-screen" id="homeScreen">
  <div class="date-badge-home">
    <div>
      <div class="dt" id="homeDate">📅 --</div>
      <div class="dy" id="homeDay">--</div>
    </div>
    <div style="text-align:left;">
      <div class="dt" id="homeYear">🎓 2025-26</div>
      <div class="dy" id="homeUser">🆔 --</div>
    </div>
  </div>

  <div class="welcome-banner">
    <div class="logo">🏫</div>
    <div class="txt">
      <h2 id="welcomeRole">خوش آمدید!</h2>
      <p>علم کی روشنی، مستقبل کی تعمیر</p>
      <small id="welcomeName">🆔 User</small>
    </div>
  </div>

  <div class="year-box">
    <b>📆 تعلیمی سال:</b>
    <select id="academicYear" onchange="changeYear()">
