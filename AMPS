var DEFAULT_SUBJECTS = [
  { name: 'اردو', total: 100 },{ name: 'انگریزی', total: 100 },
  { name: 'ریاضی', total: 100 },{ name: 'اسلامیات', total: 100 },
  { name: 'سائنس', total: 100 },{ name: 'سوشل اسٹڈیز', total: 100 }
];
