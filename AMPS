function saveAll() {
  // Save to localStorage (backup)
  localStorage.setItem('apms_students', JSON.stringify(students));
  localStorage.setItem('apms_teachers', JSON.stringify(teachers));
  localStorage.setItem('apms_classes', JSON.stringify(classes));
  localStorage.setItem('apms_tt', JSON.stringify(timetable));
  localStorage.setItem('apms_staff', JSON.stringify(staff));
  localStorage.setItem('apms_admissions', JSON.stringify(admissions));
  localStorage.setItem('apms_results', JSON.stringify(results));
  localStorage.setItem('apms_users', JSON.stringify(users));
}

