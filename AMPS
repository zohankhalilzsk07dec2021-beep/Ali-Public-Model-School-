function loadDefaultSubjects() {
  document.getElementById('subjectsContainer').innerHTML = '';
  for (var i = 0; i < DEFAULT_SUBJECTS.length; i++) addSubjectRow(DEFAULT_SUBJECTS[i].name, DEFAULT_SUBJECTS[i].total);
}

function addSubjectRow(name, total) {
  name = name || ''; total = total || 100;
  var div = document.createElement('div');
  div.className = 'subject-row';
  div.innerHTML = '<input type="text" class="sub-name" placeholder="مضمون" value="' + name + '" oninput="updateResultPreview()"><input type="number" class="sub-total" placeholder="کل" value="' + total + '" oninput="updateResultPreview()"><input type="number" class="sub-obtained" placeholder="حاصل" oninput="updateResultPreview()"><div class="sub-grade" style="text-align:center;font-weight:bold;">-</div>';
  document.getElementById('subjectsContainer').appendChild(div);
}

function getGrade(percent) {
  if (percent >= 90) return { grade: 'A+', cls: 'grade-Ap' };
  if (percent >= 80) return { grade: 'A', cls: 'grade-A' };
  if (percent >= 70) return { grade: 'B', cls: 'grade-B' };
  if (percent >= 60) return { grade: 'C', cls: 'grade-C' };
  if (percent >= 50) return { grade: 'D', cls: 'grade-D' };
  if (percent >= 40) return { grade: 'E', cls: 'grade-D' };
  return { grade: 'F', cls: 'grade-F' };
}

function updateResultPreview() {
  var rows = document.querySelectorAll('.subject-row');
  var totalSum = 0, obtainedSum = 0;
  for (var i = 0; i < rows.length; i++) {
    var row = rows[i];
    var total = parseFloat(row.querySelector('.sub-total').value) || 0;
    var obtained = parseFloat(row.querySelector('.sub-obtained').value) || 0;
    var gradeDiv = row.querySelector('.sub-grade');
    if (total > 0 && row.querySelector('.sub-obtained').value !== '') {
      var pct = (obtained / total) * 100;
      var g = getGrade(pct);
      gradeDiv.textContent = g.grade;
      gradeDiv.style.background = 'linear-gradient(135deg,#1e3c72,#2a5298)';
      gradeDiv.style.color = '#fff';
      gradeDiv.style.padding = '4px 8px';
      gradeDiv.style.borderRadius = '12px';
      gradeDiv.style.fontSize = '11px';
    } else { gradeDiv.textContent = '-'; gradeDiv.style.background = 'transparent'; gradeDiv.style.color = '#333'; }
    totalSum += total; obtainedSum += obtained;
  }
  var percent = totalSum > 0 ? ((obtainedSum / totalSum) * 100).toFixed(2) : 0;
  var overall = getGrade(percent);
  document.getElementById('sumTotal').textContent = totalSum;
  document.getElementById('sumObtained').textContent = obtainedSum;
  document.getElementById('sumPercent').textContent = percent + '%';
  document.getElementById('sumGrade').innerHTML = '<span class="grade-badge ' + overall.cls + '">' + overall.grade + '</span>';
  document.getElementById('resultSummary').style.display = 'grid';
}

function loadClassStudents() {
  var cls = document.getElementById('resClass').value;
  var sel = document.getElementById('resStudent');
  sel.innerHTML = '<option value="">طالب علم</option>';
  for (var i = 0; i < students.length; i++) if (students[i].cls === cls) sel.innerHTML += '<option value="' + students[i].id + '">' + students[i].name + ' (رول: ' + (students[i].roll||'-') + ')</option>';
}

async function saveResult() {
  var cls = document.getElementById('resClass').value;
  var studentId = parseInt(document.getElementById('resStudent').value);
  var examName = document.getElementById('resExamName').value || 'سالانہ امتحان';
  var examTerm = document.getElementById('resExamTerm').value || 'Final';
  if (!cls || !studentId) { alert('کلاس اور طالب علم منتخب کریں'); return; }
  var student = students.find(function(s) { return s.id === studentId; });
  if (!student) return;
  var subjects = []; var totalSum = 0, obtainedSum = 0;
  var rows = document.querySelectorAll('.subject-row');
  for (var i = 0; i < rows.length; i++) {
    var row = rows[i];
    var name = row.querySelector('.sub-name').value.trim();
    var total = parseFloat(row.querySelector('.sub-total').value) || 0;
    var obtained = parseFloat(row.querySelector('.sub-obtained').value) || 0;
    if (name && total > 0 && row.querySelector('.sub-obtained').value !== '') {
      var pct = (obtained / total) * 100;
      var g = getGrade(pct);
      subjects.push({ name: name, total: total, obtained: obtained, grade: g.grade, percent: pct.toFixed(1) });
      totalSum += total; obtainedSum += obtained;
    }
  }
  if (subjects.length === 0) { alert('کم از کم ایک مضمون بھریں'); return; }
  var overallPercent = (obtainedSum / totalSum) * 100;
  var overallGrade = getGrade(overallPercent);
  var resultObj = { id: Date.now(), admNo: student.admNo || '', studentId: student.id, studentName: student.name, fatherName: student.father || '', cls: cls, roll: student.roll || '', photo: student.photo || '', examName: examName, examTerm: examTerm, subjects: subjects, totalMarks: totalSum, obtainedMarks: obtainedSum, percent: overallPercent.toFixed(2), grade: overallGrade.grade, gradeClass: overallGrade.cls, academicYear: document.getElementById('academicYear').value, date: new Date().toISOString().split('T')[0] };
  await fbAdd('results', resultObj);
  results.push(resultObj);
  saveAll(); renderResultsList(); renderPrintOptions(); updateStats();
  document.getElementById('resClass').value='';
  document.getElementById('resStudent').innerHTML='<option value="">طالب علم</option>';
  document.getElementById('resExamName').value='';
  document.getElementById('resExamTerm').value='';
  loadDefaultSubjects();
  document.getElementById('resultSummary').style.display='none';
  alert('✅ نتیجہ محفوظ!\n👤 ' + student.name + '\n📊 ' + overallPercent.toFixed(2) + '%\n🎓 ' + overallGrade.grade);
}

function renderResultsList() {
  var html = '';
  for (var i = results.length - 1; i >= 0; i--) {
    var r = results[i];
    html += '<div class="admission-card" style="border-color:#9b59b6;background:linear-gradient(135deg,#fff,#f3e5f5);">';
    html += '<div class="adm-header" style="border-bottom-color:#9b59b6;"><span class="adm-no" style="background:linear-gradient(135deg,#8e44ad,#9b59b6);">' + r.examName + '</span><span class="adm-date">📅 ' + r.date + '</span></div>';
    html += '<div class="adm-body"><b>👤</b> ' + r.studentName + '<br><b>🏫</b> <span class="badge">' + (CLASS_URDU[r.cls]||r.cls) + '</span><br><b>📊</b> ' + r.obtainedMarks + '/' + r.totalMarks + ' (' + r.percent + '%)<br><b>🎓</b> <span class="grade-badge ' + r.gradeClass + '" style="padding:2px 10px;font-size:11px;">' + r.grade + '</span></div>';
    html += '<div style="display:flex;gap:5px;margin-top:5px;flex-wrap:wrap;"><button class="btn btn-gold" style="padding:6px 12px;font-size:11px;" onclick="quickPrint(' + r.id + ')">🖨️ پرنٹ</button><button class="btn btn-danger" style="padding:6px 12px;font-size:11px;" onclick="delResult(' + r.id + ')">🗑️</button></div></div>';
  }
  if (!html) html = '<div style="text-align:center;padding:20px;color:#999;">📭 کوئی نتیجہ نہیں</div>';
  document.getElementById('resultsList').innerHTML = html;
}

function quickPrint(id) { document.getElementById('printStudent').value = id; showSection('resultPrint'); generatePrintCard(); }
async function delResult(id) { if (!confirm('حذف؟')) return; await fbDelete('results', { id: id }); results = results.filter(function(r) { return r.id !== id; }); saveAll(); renderResultsList(); renderPrintOptions(); updateStats(); }

// ===== CLASSES =====
function renderClassGrid() {
  var html = '';
  for (var i = 0; i < ALL_CLASSES.length; i++) {
    var c = ALL_CLASSES[i];
    var count = 0;
    for (var j = 0; j < students.length; j++) if (students[j].cls === c) count++;
    html += '<div class="class-card"><div class="cls-num">' + (c==='Nursery'?'N':c==='KG'?'K':c.replace('Class ','')) + '</div><div><b style="font-size:11px;">' + (CLASS_URDU[c]||c) + '</b></div><div class="cls-info">👨‍🎓 ' + count + '</div></div>';
  }
  document.getElementById('classGrid').innerHTML = html;
}

// ===== TIMETABLE =====
async function addTT() {
  var cls = document.getElementById('ttClass').value;
  if (!cls) { alert('کلاس ضروری'); return; }
  var t = { id: Date.now(), cls: cls, day: document.getElementById('ttDay').value, period: document.getElementById('ttPeriod').value, subject: document.getElementById('ttSubject').value, time: document.getElementById('ttTime').value };
  await fbAdd('timetable', t);
  timetable.push(t);
  saveAll();
  ['ttPeriod','ttSubject','ttTime'].forEach(function(id) { document.getElementById(id).value = ''; });
  renderTT();
}

function renderTT() {
  var html = '';
  for (var i = 0; i < timetable.length; i++) {
    var t = timetable[i];
    html += '<div class="tt-cell"><b>' + t.cls + ' - ' + (t.day||'') + '</b>' + (t.period||'') + ' ' + (t.subject||'') + '<br><small>' + (t.time||'') + '</small><br><button class="btn btn-danger" style="padding:3px 8px;font-size:10px;margin-top:5px;" onclick="delTT(' + t.id + ')">🗑️</button></div>';
  }
  document.getElementById('ttGrid').innerHTML = html;
}

async function delTT(id) { timetable = timetable.filter(function(t) { return t.id !== id; }); await fbDelete('timetable', { id: id }); saveAll(); renderTT(); }

// ===== STUDENT CARD =====
function renderCardOptions() {
  var sel = document.getElementById('cardStudent');
  sel.innerHTML = '<option value="">طالب علم</option>';
  for (var i = 0; i < students.length; i++) sel.innerHTML += '<option value="' + students[i].id + '">' + students[i].name + ' - ' + (CLASS_URDU[students[i].cls]||students[i].cls||'') + '</option>';
}

function generateCard() {
  var id = parseInt(document.getElementById('cardStudent').value);
  var s = students.find(function(x) { return x.id === id; });
  if (!s) { alert('طالب علم منتخب کریں'); return; }
  var school = localStorage.getItem('apms_school') || 'علی پبلک ماڈل سکول';
  var year = document.getElementById('academicYear').value;
  var html = '<div class="student-card"><div class="card-header">' + school + '</div>';
  html += s.photo ? '<img src="' + s.photo + '" class="photo">' : '<div class="photo" style="display:flex;align-items:center;justify-content:center;font-size:40px;">👤</div>';
  html += '<div class="info"><p><b>نام:</b> ' + s.name + '</p><p><b>والد:</b> ' + (s.father||'-') + '</p>';
  if (s.admNo) html += '<p><b>ایڈمیشن:</b> ' + s.admNo + '</p>';
  html += '<p><b>کلاس:</b> ' + (CLASS_URDU[s.cls]||s.cls||'-') + '</p><p><b>رول:</b> ' + (s.roll||'-') + '</p><p><b>پیدائش:</b> ' + (s.dob||'-') + '</p><p><b>فون:</b> ' + (s.phone||'-') + '</p><p><b>پتہ:</b> ' + (s.address||'-') + '</p><p><b>تعلیمی سال:</b> ' + year + '</p></div>';
  html += '<div class="card-footer">💻 KHALIL Developer | © 2025</div><button class="btn btn-gold" onclick="window.print()" style="width:100%;">🖨️ پرنٹ کریں</button></div>';
  document.getElementById('cardOutput').innerHTML = html;
}

// ===== SETTINGS =====
function saveSettings() {
  var name = document.getElementById('setSchoolName').value;
  var addr = document.getElementById('setAddress').value;
  if (name) { localStorage.setItem('apms_school', name); document.getElementById('schoolName').textContent = name; }
  if (addr) { localStorage.setItem('apms_addr', addr); document.getElementById('schoolAddr').textContent = addr; }
  alert('✅ محفوظ!');
}

function clearAll() { if (!confirm('تمام ڈیٹا حذف؟')) return; localStorage.clear(); location.reload(); }

function updateStats() {
  document.getElementById('statStudents').textContent = students.length;
  document.getElementById('statTeachers').textContent = teachers.length;
  document.getElementById('statStaff').textContent = staff.length;
  document.getElementById('statResults').textContent = results.length;
}

function renderAll() {
  renderStudents(); renderTeachers(); renderClassGrid();
  renderStaff(); renderTT(); renderCardOptions();
  renderAdmissions(); renderResultsList(); renderPrintOptions();
  renderUsers(); updateStats();
}

// ===== BOOT =====
window.addEventListener('load', function() {
  initApp();
  document.getElementById('loginPass').addEventListener('keypress', function(e) { if (e.key === 'Enter') doLogin(); });
  document.getElementById('loginId').addEventListener('keypress', function(e) { if (e.key === 'Enter') document.getElementById('loginPass').focus(); });
  setInterval(updateDateTime, 30000);
  var ss = localStorage.getItem('apms_school');
  var sa = localStorage.getItem('apms_addr');
  var sy = localStorage.getItem('apms_year');
  if (ss) document.getElementById('schoolName').textContent = ss;
  if (sa) document.getElementById('schoolAddr').textContent = sa;
  if (sy) document.getElementById('academicYear').value = sy;
});
</script>
